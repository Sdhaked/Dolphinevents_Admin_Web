<IfModule mod_rewrite.c>
    RewriteEngine On

    # Allow phpadmin to open normally
    RewriteCond %{REQUEST_URI} ^/phpadmin
    RewriteRule ^ - [L]

    # Otherwise send everything to /public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<Files 403.shtml>
order allow,deny
allow from all
</Files>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84___lsphp .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
